# Copy this file to .env for local development (never commit .env)

# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Public base URL of the app (no trailing slash).
# Local dev:  http://localhost:3000
# On Render:  https://your-service-name.onrender.com
APP_URL=http://localhost:3000

# Any long random string (on Render this is generated automatically)
SESSION_SECRET=change-me-to-something-long-and-random

PORT=3000
